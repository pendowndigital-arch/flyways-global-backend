<?php

/**
 * @file
 * Update hooks for the User API module.
 */

/**
 * Adds the password reset configuration keys for sites installed before the
 * forgot-password endpoints existed.
 */
function user_api_update_10001() {
  $config = \Drupal::configFactory()->getEditable('user_api.settings');

  $config->set('password_reset_token_ttl', $config->get('password_reset_token_ttl') ?? 3600);
  $config->set('password_reset_url', $config->get('password_reset_url') ?? '');
  $config->set('password_reset_flood_limit', $config->get('password_reset_flood_limit') ?? 5);
  $config->set('password_reset_flood_window', $config->get('password_reset_flood_window') ?? 3600);

  $config->save(TRUE);
}

/**
 * Creates the fullname, phone number and bio fields on the user entity.
 *
 * These ship as config/install on new installs; sites where the module was
 * already enabled before these fields existed need them created here
 * instead, since config/install is only processed at first install.
 */
function user_api_update_10002() {
  $fields = [
    'field_fullname' => [
      'type' => 'string',
      'label' => 'Fullname',
      'required' => TRUE,
      'storage_settings' => [
        'max_length' => 255,
        'case_sensitive' => FALSE,
        'is_ascii' => FALSE,
      ],
    ],
    'field_phone_number' => [
      'type' => 'string',
      'label' => 'Phone Number',
      'required' => TRUE,
      'storage_settings' => [
        'max_length' => 255,
        'case_sensitive' => FALSE,
        'is_ascii' => FALSE,
      ],
    ],
    'field_bio' => [
      'type' => 'string_long',
      'label' => 'Bio',
      'required' => FALSE,
      'storage_settings' => [
        'case_sensitive' => FALSE,
      ],
    ],
  ];

  foreach ($fields as $field_name => $info) {
    if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('user', $field_name)) {
      \Drupal\field\Entity\FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'user',
        'type' => $info['type'],
        'settings' => $info['storage_settings'],
        'cardinality' => 1,
        'translatable' => TRUE,
      ])->save();
    }

    if (!\Drupal\field\Entity\FieldConfig::loadByName('user', 'user', $field_name)) {
      \Drupal\field\Entity\FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'user',
        'bundle' => 'user',
        'label' => $info['label'],
        'required' => $info['required'],
        'translatable' => FALSE,
      ])->save();
    }
  }
}

/**
 * Fixes sites where field_phone_number pre-dates the fields this module now
 * expects: marks fullname/phone required, and adds phone number to the
 * editable_fields and exposed_fields lists if a site's user_api.settings
 * was created before phone number support existed.
 *
 * config:import cannot be relied on to carry this kind of settings change to
 * every environment, so it is applied directly here instead.
 */
function user_api_update_10003() {
  foreach (['field_fullname', 'field_phone_number'] as $field_name) {
    $field = \Drupal\field\Entity\FieldConfig::loadByName('user', 'user', $field_name);
    if ($field && !$field->isRequired()) {
      $field->setRequired(TRUE);
      $field->save();
    }
  }

  $config = \Drupal::configFactory()->getEditable('user_api.settings');
  foreach (['editable_fields', 'exposed_fields'] as $key) {
    $fields = $config->get($key) ?? [];
    if (!in_array('field_phone_number', $fields, TRUE)) {
      $fields[] = 'field_phone_number';
      $config->set($key, $fields);
    }
  }
  $config->save(TRUE);
}

/**
 * Implements hook_install().
 *
 * Fresh installs already pull in symfony_mailer:mailer_override as a module
 * dependency, so only the config it cannot ship via config/install (existing
 * core config objects, not owned by this module) needs setting here.
 */
function user_api_install($is_syncing) {
  _user_api_enable_html_mail();
}

/**
 * Switches outgoing mail to render as HTML with clickable links, and fixes
 * the site's default sender address so authentication (SPF) lines up with
 * the domain it actually sends from.
 *
 * Sites where user_api was already installed before this existed need
 * symfony_mailer:mailer_override installed explicitly - it only auto-installs
 * as a dependency on a fresh module install, not retroactively - plus the
 * same config a fresh install gets via user_api_install().
 */
function user_api_update_10004() {
  \Drupal::service('module_installer')->install(['mailer_override']);
  _user_api_enable_html_mail();
}

/**
 * Shared by user_api_install() and user_api_update_10004().
 */
function _user_api_enable_html_mail() {
  \Drupal::configFactory()->getEditable('system.mail')
    ->set('interface.default', 'symfony_mailer')
    ->save(TRUE);

  // The site's mail was sending as an @gmail.com address while relaying
  // through Hostinger's mail servers, which SPF does not authorize for that
  // domain - a mismatch Gmail's own anti-spoofing checks reject outright,
  // while other providers were more lenient about it.
  $site_mail = \Drupal::configFactory()->getEditable('system.site');
  if ($site_mail->get('mail') === 'pendowndigital@gmail.com') {
    $site_mail->set('mail', 'no-reply@flywaysglobal.com')->save(TRUE);
  }

  $settings = \Drupal::configFactory()->getEditable('user_api.settings');
  if (trim((string) $settings->get('password_reset_url')) === '') {
    $settings->set('password_reset_url', 'https://flywaysglobal.com/password/reset/[token]')->save(TRUE);
  }
}
