# macOS
.DS_Store

# Composer-managed dependencies (recreated via `composer install`)
/vendor/

# Drupal core, scaffolded on `composer install` — not part of this repo
/core/
/modules/contrib/
/themes/contrib/
/profiles/contrib/
/autoload.php
/autoload_runtime.php
/index.php
/robots.txt
/update.php
/.htaccess
/.ht.router.php
/INSTALL.txt
/README.md
/example.gitignore
/.csslintrc
/.eslintignore
/.eslintrc.json

# Environment-specific configuration — never shared across environments
# (default.settings.php / default.services.yml are excluded separately by
# the ddev-generated sites/default/.gitignore, since composer install
# rescaffolds them from drupal/core anyway)
/sites/*/settings*.php
/sites/*/services*.yml

# User-uploaded content — lives per-environment, not in git
/sites/*/files
/sites/*/private

# Multi-site test environment
/sites/simpletest

# DDEV local dev state
.ddev/db_snapshots

# Data exports — never commit DB dumps or production archives
*.sql
*.sql.gz
db-export*
files-export*
code-export*
